*.java   text eol=lf diff=java
*.html   text eol=lf diff=html
*.css    text eol=lf
*.js     text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf
*.xml    text eol=lf

*.cur    binary
*.gif    binary
*.ico    binary
*.jar    binary
*.jpg    binary
*.jpeg   binary
*.png    binary
*.xcf    binary
*.zip    binary


