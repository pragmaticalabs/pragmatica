<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pragmatica-lite</groupId>
        <artifactId>jbct-parent</artifactId>
        <version>1.0.0-rc3</version>
    </parent>

    <artifactId>jbct-parser</artifactId>
    <packaging>jar</packaging>

    <name>JBCT Parser</name>
    <description>Java 25 PEG parser with CST output for JBCT tools (v6 lex-then-parse pipeline)</description>

    <properties>
        <!-- One version governs BOTH the runtime dependency and the generator plugin: they are
             built and released together, and a generated parser must run against its own runtime.
             The old name said "maven.plugin" while also versioning the runtime. -->
        <peglib.version>0.7.2</peglib.version>
    </properties>

    <dependencies>
        <!-- Pragmatica Lite Core -->
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- Peglib v6 runtime — CstArray / TokenArray / ParseResult / Diagnostic types used by
             the generated lex+parse code. Compile-scoped because Cursor (consumer-facing
             abstraction) wraps CstArray, so all jbct-parser consumers depend on this. -->
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>peglib-runtime</artifactId>
            <version>${peglib.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>generate-parser</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pragmatica-lite</groupId>
                        <artifactId>peglib-maven-plugin</artifactId>
                        <version>${peglib.version}</version>
                        <executions>
                            <execution>
                                <id>generate-java25-parser-v6</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>generate</goal>
                                </goals>
                                <configuration>
                                    <grammarFile>${project.basedir}/src/main/resources/grammars/java25.peg</grammarFile>
                                    <outputDirectory>${project.basedir}/src/main/java</outputDirectory>
                                    <packageName>org.pragmatica.jbct.parser.v6</packageName>
                                    <lexerClassName>Java25Lexer</lexerClassName>
                                    <parserClassName>Java25ParserV6</parserClassName>
                                    <visitorClassName>Java25Visitor</visitorClassName>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
