<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.pragmatica-lite</groupId>
        <artifactId>terra</artifactId>
        <version>1.0.0-rc4</version>
    </parent>
    <artifactId>terra-example-apps</artifactId>
    <packaging>pom</packaging>
    <name>Unchanged examples packaged for Terra</name>
    <modules>
        <module>ecommerce-shared</module>
        <module>ecommerce-pricing</module>
        <module>ecommerce-inventory</module>
        <module>ecommerce-payment</module>
        <module>ecommerce-fulfillment</module>
        <module>ecommerce-order</module>
        <module>ecommerce-app</module>
        <module>url-shortener</module>
        <module>step-composition</module>
        <module>pricing-engine</module>
        <module>pg-showcase</module>
        <module>comprehensive-persistence</module>
        <module>url-shortener-v2</module>
        <module>banking-shared</module>
        <module>banking-account</module>
        <module>banking-exchange</module>
        <module>banking-fraud</module>
        <module>banking-transfer</module>
        <module>banking-app</module>
        <module>tests</module>
    </modules>
    <properties>
        <terra.example.group>org.pragmatica-lite.aether.example</terra.example.group>
        <terra.example.version>${project.version}</terra.example.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>terra-launcher</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>slice-annotations</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>resource-interceptors</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>resource-db-jdbc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>pg-codegen</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.5</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.pragmatica-lite</groupId>
                                <artifactId>slice-processor</artifactId>
                                <version>${project.version}</version>
                            </path>
                            <path>
                                <groupId>org.pragmatica-lite.aether</groupId>
                                <artifactId>pg-codegen</artifactId>
                                <version>${project.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Aslice.target=terra</arg>
                            <arg>-Aslice.groupId=${terra.example.group}</arg>
                            <arg>-Aslice.artifactId=${terra.example.artifact}</arg>
                            <arg>-Aslice.version=${terra.example.version}</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
