#!/bin/sh
set -eu
terra_app_home=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -n "${JAVA_HOME:-}" ]; then terra_java="$JAVA_HOME/bin/java"; else terra_java=java; fi
# JAVA_OPTS: JVM options split on whitespace, expanded unquoted on purpose (no quote parsing); -f keeps a "*" in an option literal.
set -f
exec "$terra_java" --enable-preview ${JAVA_OPTS:-} -cp "$terra_app_home/lib/*" org.pragmatica.terra.launcher.TerraMain "$terra_app_home/application" "$@"
