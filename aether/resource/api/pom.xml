<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.pragmatica-lite.aether</groupId>
        <artifactId>resource</artifactId>
        <version>1.0.0-rc5</version>
    </parent>

    <artifactId>resource-api</artifactId>
    <name>Aether Resource API</name>
    <description>Resource factory SPI, database connector interfaces, HTTP client interfaces, configuration service, and aspect configuration types.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <!-- Fray controlled-concurrency tests (#3162). One version for the test dependency and the plugin that builds the
             instrumented JDK those tests need. -->
        <fray.version>0.9.2</fray.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>config-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>utility</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>slice-api</artifactId>
        </dependency>
        <!-- JsonText and the generated json/jsonb column codecs of pg-codegen factories -->
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>serialization-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>toml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>http-client</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- A Fray test needs Fray's runtime classes, which only the `fray` profile supplies (its instrumented JDK): the
                 class does not even load without them, so the default build does not compile it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <testExclude>**/*FrayTest.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>false</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn test -Pfray -pl aether/resource/api`: compiles and runs ONLY the Fray tests (tag FrayTest). `prepare-fray` jlinks an
             instrumented JDK into target/ and puts the Fray agent into `argLine` and the instrumented `java` into `jvm`;
             the root surefire `argLine` is a literal, so it is restated here with `@{argLine}` to carry the agent.
             Own profile, not an own execution: the instrumented JDK costs a jlink per build and the agent must not slow
             the module's ordinary tests. -->
        <profile>
            <id>fray</id>
            <properties>
                <argLine></argLine>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.pastalab.fray</groupId>
                    <artifactId>fray-junit</artifactId>
                    <version>${fray.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes combine.self="override"/>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.pastalab.fray.maven</groupId>
                        <artifactId>fray-plugins-maven</artifactId>
                        <version>${fray.version}</version>
                        <executions>
                            <execution>
                                <id>prepare-fray</id>
                                <goals>
                                    <goal>prepare-fray</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>${vthread.argLine} @{argLine}</argLine>
                            <groups>FrayTest</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
