            <artifactId>versioned-slice</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            === Compile-time needs of the gate's own sources, beyond the ordering list above ===

            resource-api and serialization-api are NOT modules of aether/pom.xml's <modules> list
            (resource-api is a child of the `resource` aggregator; serialization-api lives outside
            aether entirely), so they carry no corpus obligation. They are here because
            DeadSurfaceCommissioningTest names TopicConfig/ScheduleConfig/DatabaseConnectorConfig and
            SliceCodec directly and would not compile without them.
        -->
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>resource-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>serialization-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- === Test harness === -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
        <!-- #519 dead-surface guard: bytecode reachability scanning, test-scope only -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
