<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.pragmatica-lite.aether</groupId>
        <artifactId>aether</artifactId>
        <version>1.0.0-rc4</version>
    </parent>

    <artifactId>dead-surface-gate</artifactId>
    <name>Aether Dead Surface Gate</name>
    <description>
        #519 dead-config-accessor gate. Test-only module: it owns no production code, it scans everyone
        else's. Originated with the operator-surface stream; moved here from aether/node unchanged.
    </description>

    <!--
        WHY THIS MODULE EXISTS AS ITS OWN MODULE, LAST IN aether/pom.xml's <modules> LIST.

        The gate's corpus is every module declared in aether/pom.xml's default <modules> block, read
        from each one's target/classes (see ReactorRoots). Mounted in aether/node, that corpus was
        impossible to satisfy: aether/ember and others DEPEND on node, so Maven builds them strictly
        AFTER it. In a clean full-reactor run their target/classes does not exist yet when node's tests
        execute, and the gate's corpus precondition correctly refuses — it passed locally only when
        stale target/ output from an earlier build happened to be lying around. A gate that only passes
        on a dirty tree is not a gate.

        The fix is structural, not a softened precondition: EVERY module the gate scans is declared
        below as a test-scoped dependency. Maven's reactor then cannot schedule this module before any
        of them, in any build order, on any machine, so corpus completeness is enforced by construction
        rather than by hope. The precondition stays exactly as loud as it was.

        MAINTENANCE CONTRACT: this dependency list must mirror aether/pom.xml's default <modules> list
        one-for-one. Add a module there, add it here. If you don't, the gate silently scans a smaller
        corpus than it claims — which is the false-DEAD failure mode #519 was built to avoid. The
        profile-gated modules (e2e-tests, cloud-tests, under <profile>) are deliberately absent: they
        are not in the default reactor, and ReactorRoots does not read them either.
    -->
    <dependencies>
        <!-- === Corpus modules: one entry per <module> in aether/pom.xml's default <modules> list === -->
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>slice-annotations</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>aether-config</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>aether-setup</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>dashboard</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>slice-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>environment-integration</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            environment, resource, forge and pg-tools are aggregator poms with no src/main/java, so
            they contribute no target/classes to the corpus and ReactorRoots' precondition skips them.
            They are still listed, with <type>pom</type>, to keep the one-for-one correspondence with
            the <modules> list checkable by eye: a reader comparing the two lists should find no gaps
            to reason about.
        -->
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>environment</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>resource</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>slice</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>aether-management-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>aether-stream</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
