<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.pragmatica-lite.aether</groupId>
        <artifactId>aether</artifactId>
        <version>1.0.0-rc5</version>
    </parent>

    <artifactId>http-routing-adapter</artifactId>
    <name>Aether HTTP Routing Adapter</name>
    <description>Adapter bridging http-handler-api types with http-routing for slice request processing.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <!-- Aether HTTP Handler API -->
        <dependency>
            <groupId>org.pragmatica-lite.aether</groupId>
            <artifactId>http-handler-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Pragmatica Lite -->
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>http-routing</artifactId>
        </dependency>
        <!-- Generated route codecs run on this runtime; slices get it through their provided dependency here. -->
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>serialization-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>jackson</artifactId>
        </dependency>

        <!-- Testing -->
        <!-- Runs over @Json test records, so the generated-codec path is tested with real generated code. -->
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>serialization-codec-processor</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.pragmatica-lite</groupId>
            <artifactId>test-logging</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>false</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
